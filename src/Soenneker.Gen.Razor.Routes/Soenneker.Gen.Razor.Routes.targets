<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="RazorRoutesGeneratorBuild_Imported" BeforeTargets="Build">
        <Message Importance="high" Text="Soenneker.Gen.Razor.Routes targets imported from: $(MSBuildThisFileFullPath)" />
    </Target>

    <PropertyGroup>
        <!-- Select the SDK host rather than the application's RuntimeIdentifier (for example browser-wasm). -->
        <RazorRoutesToolRuntimeIdentifier Condition="'$(RazorRoutesToolRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RazorRoutesToolRuntimeIdentifier>
        <_RazorRoutesExecutableName>Soenneker.Gen.Razor.Routes.BuildTasks</_RazorRoutesExecutableName>
        <_RazorRoutesExecutableName Condition="$([System.String]::Copy('$(RazorRoutesToolRuntimeIdentifier)').StartsWith('win-'))">$(_RazorRoutesExecutableName).exe</_RazorRoutesExecutableName>
        <_RazorRoutesNativePackagePath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/native/$(RazorRoutesToolRuntimeIdentifier)/$(_RazorRoutesExecutableName)'))</_RazorRoutesNativePackagePath>
        <_RazorRoutesNativeProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../artifacts/native/$(RazorRoutesToolRuntimeIdentifier)/$(_RazorRoutesExecutableName)'))</_RazorRoutesNativeProjectPath>
        <RazorRoutesBuildTasksExecutablePath Condition="'$(RazorRoutesBuildTasksExecutablePath)' == '' and Exists('$(_RazorRoutesNativePackagePath)')">$(_RazorRoutesNativePackagePath)</RazorRoutesBuildTasksExecutablePath>
        <RazorRoutesBuildTasksExecutablePath Condition="'$(RazorRoutesBuildTasksExecutablePath)' == ''">$(_RazorRoutesNativeProjectPath)</RazorRoutesBuildTasksExecutablePath>

        <RazorRoutesEnabled Condition="'$(RazorRoutesEnabled)'=='' and '$(RazorRoutesGeneratorBuildEnabled)'!=''">$(RazorRoutesGeneratorBuildEnabled)</RazorRoutesEnabled>
        <RazorRoutesEnabled Condition="'$(RazorRoutesEnabled)'==''">true</RazorRoutesEnabled>
        <RazorRoutesBlazorAppDirectory Condition="'$(RazorRoutesBlazorAppDirectory)'==''">$(ProjectDir)</RazorRoutesBlazorAppDirectory>
        <RazorRoutesOutputPath Condition="'$(RazorRoutesOutputPath)'==''">routes.txt</RazorRoutesOutputPath>
        <RazorRoutesIncludeDynamicRoutes Condition="'$(RazorRoutesIncludeDynamicRoutes)'==''">true</RazorRoutesIncludeDynamicRoutes>
        <_RazorRoutesProjectDir>$([System.IO.Path]::GetDirectoryName('$(ProjectDir)x'))</_RazorRoutesProjectDir>
        <_RazorRoutesProjectDir Condition="'$(_RazorRoutesProjectDir)' == ''">$(MSBuildProjectDirectory)</_RazorRoutesProjectDir>
        <_RazorRoutesBlazorAppDirectoryArg Condition="'$(RazorRoutesBlazorAppDirectory)' != ''"> --blazorAppDir &quot;$(RazorRoutesBlazorAppDirectory)&quot;</_RazorRoutesBlazorAppDirectoryArg>
        <_RazorRoutesOutputPathArg Condition="'$(RazorRoutesOutputPath)' != ''"> --outputPath &quot;$(RazorRoutesOutputPath)&quot;</_RazorRoutesOutputPathArg>
        <_RazorRoutesIncludeDynamicRoutesArg> --includeDynamicRoutes &quot;$(RazorRoutesIncludeDynamicRoutes)&quot;</_RazorRoutesIncludeDynamicRoutesArg>
    </PropertyGroup>

    <Target Name="RunRazorRoutesGeneratorBuildTasks"
            BeforeTargets="BeforeBuild"
            Condition="'$(DesignTimeBuild)'!='true' and '$(IsCrossTargetingBuild)'!='true' and '$(RazorRoutesEnabled)'=='true'">

        <Message Importance="high" Text="Running Soenneker.Gen.Razor.Routes BuildTasks: projectDir=$(_RazorRoutesProjectDir) blazorAppDir=$(RazorRoutesBlazorAppDirectory) output=$(RazorRoutesOutputPath)" />
        <Error Condition="'$(_RazorRoutesProjectDir)' == ''"
               Text="Soenneker.Gen.Razor.Routes: project directory could not be resolved." />
        <Error Condition="'$(RazorRoutesBuildTasksExecutablePath)'==''"
               Text="RazorRoutesBuildTasksExecutablePath was not resolved. MSBuildThisFileDirectory=$(MSBuildThisFileDirectory)" />
        <Error Condition="!Exists('$(RazorRoutesBuildTasksExecutablePath)')"
               Text="Razor routes native BuildTasks executable not found at '$(RazorRoutesBuildTasksExecutablePath)'." />

        <!-- NuGet extraction does not preserve Unix execute permissions. -->
        <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(RazorRoutesBuildTasksExecutablePath)&quot;" />
        <Exec WorkingDirectory="$(_RazorRoutesProjectDir)"
              IgnoreExitCode="false"
              ConsoleToMSBuild="true"
              StandardOutputImportance="high"
              StandardErrorImportance="high"
              Command='&quot;$(RazorRoutesBuildTasksExecutablePath)&quot; --projectDir &quot;$(_RazorRoutesProjectDir)&quot;$(_RazorRoutesBlazorAppDirectoryArg)$(_RazorRoutesOutputPathArg)$(_RazorRoutesIncludeDynamicRoutesArg)' />
    </Target>
</Project>
