<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591;</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Automatic route file generation for Razor apps at build time. Fast, deterministic, and zero-runtime overhead.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Gen.Razor.Routes</AssemblyName>
        <PackageId>Soenneker.Gen.Razor.Routes</PackageId>
        <PackageTags>gen razor routes blazor generation source razorroutesgenerator externalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.gen.razor.routes</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.gen.razor.routes</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Gen.Razor.Routes.targets" Pack="true" PackagePath="build\" />
        <None Include="Soenneker.Gen.Razor.Routes.targets" Pack="true" PackagePath="buildTransitive\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <RazorRoutesNativeRuntimeIdentifier Condition="'$(RazorRoutesNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RazorRoutesNativeRuntimeIdentifier>
        <RazorRoutesNativeArtifactsDir Condition="'$(RazorRoutesNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</RazorRoutesNativeArtifactsDir>
        <_RazorRoutesNativeExecutable>Soenneker.Gen.Razor.Routes.BuildTasks</_RazorRoutesNativeExecutable>
        <_RazorRoutesNativeExecutable Condition="$([System.String]::Copy('$(RazorRoutesNativeRuntimeIdentifier)').StartsWith('win-'))">$(_RazorRoutesNativeExecutable).exe</_RazorRoutesNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(RazorRoutesUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(RazorRoutesNativeSource);../Soenneker.Gen.Razor.Routes.BuildTasks/obj/project.assets.json"
            Outputs="$(RazorRoutesNativeArtifactsDir)/$(RazorRoutesNativeRuntimeIdentifier)/$(_RazorRoutesNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Gen.Razor.Routes.BuildTasks/Soenneker.Gen.Razor.Routes.BuildTasks.csproj&quot; --configuration Release --runtime $(RazorRoutesNativeRuntimeIdentifier) --output &quot;$(RazorRoutesNativeArtifactsDir)/$(RazorRoutesNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <RazorRoutesNativeSource Include="../Soenneker.Gen.Razor.Routes.BuildTasks/**/*.cs;../Soenneker.Gen.Razor.Routes.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Gen.Razor.Routes.BuildTasks/bin/**;../Soenneker.Gen.Razor.Routes.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_RazorRoutesRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(RazorRoutesUsePrebuiltNativeTools)' == 'true'" />
            <_RazorRoutesNativeFile Include="$(RazorRoutesNativeArtifactsDir)/**/*"
                                Exclude="$(RazorRoutesNativeArtifactsDir)/**/*.pdb;$(RazorRoutesNativeArtifactsDir)/**/*.dbg;$(RazorRoutesNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_RazorRoutesNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_RazorRoutesRequiredRuntime)' != '' and !Exists('$(RazorRoutesNativeArtifactsDir)/%(_RazorRoutesRequiredRuntime.Identity)/Soenneker.Gen.Razor.Routes.BuildTasks') and !Exists('$(RazorRoutesNativeArtifactsDir)/%(_RazorRoutesRequiredRuntime.Identity)/Soenneker.Gen.Razor.Routes.BuildTasks.exe')"
               Text="Missing native routes tool for %(_RazorRoutesRequiredRuntime.Identity)." />
        <Error Condition="'@(_RazorRoutesNativeFile)' == ''" Text="Native routes tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
